{
  "name": "oc-server",
  "version": "4.0.4",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run test --threads=false",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/plugin.js",
      "require": "./dist/vite/plugin.js",
      "types": "./dist/vite/plugin.d.ts"
    }
  },
  "keywords": [
    "oc",
    "opencomponents"
  ],
  "author": {
    "name": "Ricardo Devis Agullo",
    "email": "mkredz@gmail.com"
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/express": "^4.0.9",
    "fastify": "^5.12.7",
    "oc-client-browser": "^1.8.0",
    "oc-vite-compiler": "^6.0.2"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.1.3"
  }
}
