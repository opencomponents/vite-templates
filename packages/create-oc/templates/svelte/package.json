{
  "name": "base-component-svelte",
  "description": "",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "oc-server dev",
    "build": "npm run check && oc package .",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "postinstall": "node fixBuild.mjs"
  },
  "oc": {
    "files": {
      "data": "src/server.ts",
      "template": {
        "src": "src/App.svelte",
        "type": "oc-template-svelte"
      },
      "static": [
        "public"
      ]
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^30.1.2",
    "oc-server": "^4.0.3",
    "oc-template-svelte-compiler": "^3.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}